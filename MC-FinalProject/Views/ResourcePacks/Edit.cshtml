@model MC_FinalProject.Models.ResourcePack

@{
    ViewData["Title"] = "Edit Resource Pack";
}

<h2>Edit Resource Pack</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Author" class="control-label">Author</label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DownloadUrl" class="control-label">Download URL</label>
                <input asp-for="DownloadUrl" class="form-control" />
                <span asp-validation-for="DownloadUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceCategoryId" class="control-label">Category</label>
                <select asp-for="ResourceCategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))"></select>
                <span asp-validation-for="ResourceCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceFeatureId" class="control-label">Feature</label>
                <select asp-for="ResourceFeatureId" class="form-control" asp-items="@(new SelectList(ViewBag.Features, "Id", "Name"))"></select>
                <span asp-validation-for="ResourceFeatureId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResourceResolutionId" class="control-label">Resolution</label>
                <select asp-for="ResourceResolutionId" class="form-control" asp-items="@(new SelectList(ViewBag.Resolutions, "Id", "Name"))"></select>
                <span asp-validation-for="ResourceResolutionId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GameVersionId" class="control-label">Game Version</label>
                <select asp-for="GameVersionId" class="form-control" asp-items="@(new SelectList(ViewBag.GameVersions, "Id", "VersionNumber"))"></select>
                <span asp-validation-for="GameVersionId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Save Changes" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}