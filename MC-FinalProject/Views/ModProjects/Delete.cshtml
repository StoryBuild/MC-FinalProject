@model MC_FinalProject.Models.ModProject

@{
    ViewData["Title"] = "Изтрий мод";
}

<h2 class="text-danger">Сигурни ли сте, че искате да изтриете този мод?</h2>

<div class="card bg-dark text-white p-4 mt-3">
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Автор:</dt>
        <dd class="col-sm-10">@Model.Author</dd>

        <dt class="col-sm-2">Описание:</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Категория:</dt>
        <dd class="col-sm-10">@Model.Category.Name</dd>

        <dt class="col-sm-2">Версия:</dt>
        <dd class="col-sm-10">@Model.GameVersion.VersionNumber</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий завинаги" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Отказ</a>
    </form>
</div>