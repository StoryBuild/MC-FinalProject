@model MC_FinalProject.Models.ModProject

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 350px; width: 100%; object-fit: cover;">
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded shadow" style="height: 250px;">
                    <span>Няма налична снимка</span>
                </div>
            }
        </div>

        <div class="col-md-8">
            <h1 class="display-5 fw-bold">@Model.Title</h1>
            <h4 class="text-muted mb-3">Автор: <span class="text-info">@Model.Author</span></h4>

            <p class="lead">@Model.Description</p>

            <hr />

            <div class="row mb-4">
                <div class="col-md-4">
                    <strong>Категория:</strong> <span class="badge bg-primary">@Model.Category.Name</span>
                </div>
                <div class="col-md-4">
                    <strong>Версия на играта:</strong> <span class="badge bg-secondary">@Model.GameVersion.VersionNumber</span>
                </div>
                <div class="col-md-4">
                    <strong>Лоудър:</strong> <span class="badge bg-success">@Model.ModLoader.Name</span>
                </div>
            </div>

            <div class="mb-4">
                <strong>Среда (Environment):</strong> <span class="badge bg-warning text-dark">@Model.Environment</span>
            </div>

            <div class="d-flex gap-3">
                <a href="@Model.DownloadUrl" target="_blank" class="btn btn-lg btn-danger px-4">
                    <i class="bi bi-download"></i> Изтегли от CurseForge
                </a>
                <a asp-action="Index" class="btn btn-lg btn-outline-secondary">Назад към списъка</a>
            </div>
        </div>
    </div>
</div>