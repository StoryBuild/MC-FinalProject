@model IEnumerable<MC_FinalProject.Models.ModProject>

@{
    ViewData["Title"] = "Каталог с модове";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Разгледай Модове</h2>
    <a asp-action="Create" class="btn btn-success">Добави нов мод</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 bg-dark text-white border-secondary">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <h6 class="card-subtitle mb-2 text-info">By @item.Author</h6>
                    <p class="card-text text-truncate">@item.Description</p>
                </div>
                <div class="card-footer d-flex justify-content-between border-secondary">
                    <small>@item.Category.Name | @item.GameVersion.VersionNumber</small>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Детайли</a>
                </div>
            </div>
        </div>
    }
</div>