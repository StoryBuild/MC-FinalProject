@model MC_FinalProject.Models.ModProject

@{
    ViewData["Title"] = "Добави нов мод";
}

<h2>Добавяне на мод</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label">Заглавие на мода</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Author" class="control-label">Автор</label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label">URL към картинка (по избор)</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DownloadUrl" class="control-label">CurseForge Линк за изтегляне</label>
                <input asp-for="DownloadUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="DownloadUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="control-label">Категория</label>
                <select asp-for="CategoryId" class="form-control" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                    <option value="">-- Избери Категория --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GameVersionId" class="control-label">Версия на играта</label>
                <select asp-for="GameVersionId" class="form-control" asp-items="@(new SelectList(ViewBag.GameVersions, "Id", "VersionNumber"))">
                    <option value="">-- Избери Версия --</option>
                </select>
                <span asp-validation-for="GameVersionId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ModLoaderId" class="control-label">Mod Loader</label>
                <select asp-for="ModLoaderId" class="form-control" asp-items="@(new SelectList(ViewBag.ModLoaders, "Id", "Name"))">
                    <option value="">-- Избери Loader --</option>
                </select>
                <span asp-validation-for="ModLoaderId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Environment" class="control-label">Среда (Environment)</label>
                <select asp-for="Environment" class="form-control">
                    <option value="">-- Избери Среда --</option>
                    <option value="Client">Client</option>
                    <option value="Server">Server</option>
                    <option value="Both">Both</option>
                </select>
                <span asp-validation-for="Environment" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Запази" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}